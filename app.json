{
  "expo": {
    "name": "Around",
    "slug": "around",
    "scheme": "around",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.around.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Around uses your location to show nearby activity. Your live location is never shared.",
        "NSPhotoLibraryUsageDescription": "Around needs access to one photo for each activity you publish."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.around.app",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Around uses your location to show nearby activity. Your live location is never shared."
        }
      ],
      "@rnmapbox/maps",
      [
        "expo-image-picker",
        {
          "photosPermission": "Around needs access to one photo for each activity you publish.",
          "microphonePermission": false
        }
      ]
    ]
    ,"web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
